// Standalone Cloudflare Worker (its own repo/deploy), NOT part of the Commons
// OpenNext bundle. Deploys as `ow-data` and owns the hourly cron that snapshots
// Overwatch careers into the ow-player-data D1, plus the cross-provider
// player-data sync (external FACEIT/start.gg teams + match history, the pd_*
// tables in the same database).
//
// Secrets (wrangler secret put; .dev.vars locally):
//   OW_POLLER_SECRET — gates the manual POST /run trigger.
//   FACEIT_API_KEY   — FACEIT Data API key for the pd sync (same value as the
//                      Commons'); unset leaves FACEIT rows to page-open syncs.
//   STARTGG_API_KEY  — start.gg personal token, likewise.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ow-data",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  // Hourly, on the hour (UTC). Each tick handles the poll_chunk == UTC hour.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      // The SAME database the Commons binds as OW. The Commons owns the ow_* and
      // pd_* schema + migrations (drizzle-ow/); this Worker owns ONLY the
      // faceit_* tables (the FACEIT match search cache) and migrates them from
      // `drizzle-faceit/`. The two owners never collide because their applied-
      // migration tracking lives in SEPARATE tables (migrations_table below vs.
      // the Commons' default) and their table sets are disjoint. For ow_*/pd_*
      // this Worker still only reads/writes rows.
      "binding": "OW",
      "database_name": "ow-player-data",
      "database_id": "770f85f6-d90c-4d35-852b-8296f672b7f9",
      "migrations_dir": "drizzle-faceit",
      "migrations_table": "d1_migrations_faceit"
    }
  ],
  "vars": {
    // Optional OverFast base override; unset uses the public instance.
    // "OVERFAST_API_URL": "https://overfast-api.tekrop.fr"
  },
  "observability": {
    "enabled": true
  }
}
