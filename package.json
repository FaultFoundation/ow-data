{
  "name": "ow-data",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hourly Cloudflare Worker that snapshots Overwatch player careers into the shared ow-player-data D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:faceit:generate": "drizzle-kit generate",
    "db:faceit:migrate:local": "wrangler d1 migrations apply ow-player-data --local",
    "db:faceit:migrate:remote": "wrangler d1 migrations apply ow-player-data --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5",
    "wrangler": "^4.125.0"
  }
}
